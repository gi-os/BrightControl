<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Shake-to-report posts the issue to GitHub. Nothing else in this app is online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Brightness. An appop rather than a runtime permission, and LightOS has no Settings
      screen that grants it, so it is granted once over adb:

        adb shell appops set com.gios.lightcontrol WRITE_SETTINGS allow

      Unlike an app adjusting its own window, a service has no window to fall back on:
      without this grant the wheel cannot change brightness at all, which is why the
      settings screen reports the grant rather than failing quietly.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      Per-app color, and the on-device ADB screen's own self-grant. LightOS pins the whole
      phone to monochrome through the accessibility daltonizer; driving that per-app needs this,
      and it is signature|privileged so it never comes from a runtime prompt. Granted once, from
      the app's own ADB screen or a computer:

        adb shell pm grant com.gios.lightcontrol android.permission.WRITE_SECURE_SETTINGS

      Absent, the color feature is inert (every write is swallowed) rather than crashing.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Two jobs: the brightness readout is an overlay window, and on Android 14 this appop
      is also what exempts a sideloaded app from background-activity-start restrictions —
      which is what lets the camera button open the camera from a service.

        adb shell appops set com.gios.lightcontrol SYSTEM_ALERT_WINDOW allow
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The per-app override list needs the names of installed apps. QUERY_ALL_PACKAGES is
      the blunt instrument, but the alternative is a <queries> block that can only ask
      about packages known in advance, and the whole point is a list of everything the
      user has sideloaded.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      The lock face's top bar. A normal permission, granted at install: it answers only
      "is anything connected, and over what", which is what a status bar is for. Signal
      *bars* are deliberately not shown - those need READ_PHONE_STATE, a runtime
      permission LightOS has no screen to grant, and a bar count that silently reads
      empty on a phone with full signal is worse than no bars at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The Wi-Fi login screen's state row: which network is Wi-Fi, and has it validated. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      The hotspot. Everything below is for the presence trigger folded in from BrightHotspot,
      and every one of them is a runtime prompt or a normal permission - the privileged half,
      raising the access point itself, goes over this app's own adb shell instead. See
      hotspot/SoftAp.kt.

      BLUETOOTH_SCAN is what hears the iPad advertising. ACCESS_FINE_LOCATION comes with it on
      this platform whether or not anybody wants a location: a BLE scan is a location signal as
      far as Android is concerned, and neverForLocation is not enough on its own for a scan that
      resolves bonded addresses.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      So the shell comes back by itself after a restart, which is the whole reason this feature
      moved into this app. See hotspot/HotspotBoot.kt.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Signal bars on the lock face, and nothing else. A runtime permission LightOS has
      no screen for, so it is granted once over adb:

        adb shell pm grant com.gios.lightcontrol android.permission.READ_PHONE_STATE

      Without it the cellular bars are drawn as empty outlines rather than as zero -
      "not known" and "no signal" must not look the same. Wi-Fi strength needs nothing.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      The lock face's call card, and only as the fallback underneath the notification's own
      buttons. Answering normally means sending the PendingIntent the dialer already put in the
      shade, which needs nothing granted; this is what answers a call whose buttons could not be
      identified by the words on them, through TelecomManager. A runtime permission with no
      LightOS screen to grant it, so it goes the same way as the rest:

        adb shell pm grant com.gios.lightcontrol android.permission.ANSWER_PHONE_CALLS

      Without it the card still draws and still answers on every dialer that labels its buttons.
    -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      The call speaker's level. A normal permission, granted at install. It moves one index on one
      stream, once per call, and only while the route is the phone's own speaker - see
      keys/CallAudio.kt for why that index is the ceiling for any app on this phone.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      The lock background's photo grid. An ordinary runtime prompt, granted from the
      app itself. Needed because the grid walks DCIM and Pictures by path instead of
      asking MediaStore - nothing on LightOS keeps MediaStore current, so the system
      picker does not offer a photo taken minutes ago. A directory listing cannot go
      stale. Same reason BrightChat reads the camera roll this way.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
      The switcher's hold-to-stop, when there is no adb shell to do it properly. A *normal*
      permission, granted at install with nothing to ask for, and genuinely weaker than a force
      stop: it kills background processes and leaves a foreground app and its scheduled work
      alone. The real thing goes over this app's own adb shell instead. See switcher/ForceStop.kt.
    -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LightControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LightControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              An app in BrightMarket asking for the ADB setup its README describes. Exported on
              purpose, because the sender is another app. Nothing that arrives is executed as
              written: adb/GrantRequest.kt rebuilds every command, pinned to the requesting
              package, and the user approves the result before any of it runs.
            -->
            <intent-filter>
                <action android:name="com.gios.lightcontrol.action.RUN_GRANTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The captive-portal sign-in page. Plain http is allowed app-wide
          (usesCleartextTraffic above) because a portal can only hijack a request it can read:
          the probe URL is http on purpose, and portals themselves are routinely http. Exported
          with the system's CAPTIVE_PORTAL action so "sign in to network" can land here too;
          mostly it is opened by hand from the Wi-Fi login settings screen.
        -->
        <activity
            android:name=".portal.PortalActivity"
            android:exported="true"
            android:label="Wi-Fi login"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LightControl">
            <intent-filter>
                <action android:name="android.net.conn.CAPTIVE_PORTAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The lock face is a window, not an activity - added by ControlService at
          TYPE_ACCESSIBILITY_OVERLAY, which is layer 31 and so sits above the keyguard
          at 17. There is deliberately no activity here: `showWhenLocked` marks the
          keyguard *occluded*, and an occluded keyguard stops listening to a
          power-button fingerprint sensor. See lock/LockOverlay.kt.
        -->

        <!--
          Reads the shade so the lock face can list it. Granted once over adb, like
          everything else this app needs:

            adb shell cmd notification allow_listener com.gios.lightcontrol/.lock.LockNotifications

          Nothing is stored and nothing leaves the phone; the list is rebuilt from
          activeNotifications on every change and lives in memory in this process.
        -->
        <service
            android:name=".lock.LockNotifications"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".keys.ControlService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>

        <!--
          Reads the six-digit code off the system pairing dialog so setup needs no computer.
          Scoped to the Settings package in adb_pair_service.xml, and inert unless the user has
          just tapped PAIR AUTOMATICALLY. Separate from ControlService so that service can keep
          its canRetrieveWindowContent="false".
        -->
        <!--
          The presence loop. A foreground service because that is the only way LightOS lets a
          sideloaded app keep a BLE scan alive with the screen off, which is the entire point:
          the hotspot is meant to come up while the phone sits in a pocket.

          Its own service rather than a job on ControlService. The key filter is what this
          phone's buttons depend on, and a scan that misbehaves must not be able to take it
          down - an accessibility service that throws often enough is stood down by the system,
          and standing down the key filter to fix a hotspot would be a poor trade.
        -->
        <service
            android:name=".hotspot.HotspotService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".hotspot.HotspotBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".adb.AdbPairReader"
            android:exported="true"
            android:label="@string/adb_pair_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/adb_pair_service" />
        </service>
    </application>
</manifest>
