<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shake-to-report posts the issue to GitHub. Nothing else in this app is online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Brightness. An appop rather than a runtime permission, and LightOS has no Settings
      screen that grants it, so it is granted once over adb:

        adb shell appops set com.gios.lightcontrol WRITE_SETTINGS allow

      Unlike an app adjusting its own window, a service has no window to fall back on:
      without this grant the wheel cannot change brightness at all, which is why the
      settings screen reports the grant rather than failing quietly.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      Two jobs: the brightness readout is an overlay window, and on Android 14 this appop
      is also what exempts a sideloaded app from background-activity-start restrictions —
      which is what lets the camera button open the camera from a service.

        adb shell appops set com.gios.lightcontrol SYSTEM_ALERT_WINDOW allow
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The per-app override list needs the names of installed apps. QUERY_ALL_PACKAGES is
      the blunt instrument, but the alternative is a <queries> block that can only ask
      about packages known in advance, and the whole point is a list of everything the
      user has sideloaded.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      The lock face's top bar. A normal permission, granted at install: it answers only
      "is anything connected, and over what", which is what a status bar is for. Signal
      *bars* are deliberately not shown - those need READ_PHONE_STATE, a runtime
      permission LightOS has no screen to grant, and a bar count that silently reads
      empty on a phone with full signal is worse than no bars at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Signal bars on the lock face, and nothing else. A runtime permission LightOS has
      no screen for, so it is granted once over adb:

        adb shell pm grant com.gios.lightcontrol android.permission.READ_PHONE_STATE

      Without it the cellular bars are drawn as empty outlines rather than as zero -
      "not known" and "no signal" must not look the same. Wi-Fi strength needs nothing.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      The lock background's photo grid. An ordinary runtime prompt, granted from the
      app itself. Needed because the grid walks DCIM and Pictures by path instead of
      asking MediaStore - nothing on LightOS keeps MediaStore current, so the system
      picker does not offer a photo taken minutes ago. A directory listing cannot go
      stale. Same reason BrightChat reads the camera roll this way.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LightControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The lock face is a window, not an activity - added by ControlService at
          TYPE_ACCESSIBILITY_OVERLAY, which is layer 31 and so sits above the keyguard
          at 17. There is deliberately no activity here: `showWhenLocked` marks the
          keyguard *occluded*, and an occluded keyguard stops listening to a
          power-button fingerprint sensor. See lock/LockOverlay.kt.
        -->

        <!--
          Reads the shade so the lock face can list it. Granted once over adb, like
          everything else this app needs:

            adb shell cmd notification allow_listener com.gios.lightcontrol/.lock.LockNotifications

          Nothing is stored and nothing leaves the phone; the list is rebuilt from
          activeNotifications on every change and lives in memory in this process.
        -->
        <service
            android:name=".lock.LockNotifications"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".keys.ControlService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>
    </application>
</manifest>
