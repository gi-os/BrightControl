<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Shake-to-report posts the issue to GitHub. Nothing else in this app is online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Brightness. An appop rather than a runtime permission, and LightOS has no Settings
      screen that grants it, so it is granted once over adb:

        adb shell appops set com.gios.lightcontrol WRITE_SETTINGS allow

      Unlike an app adjusting its own window, a service has no window to fall back on:
      without this grant the wheel cannot change brightness at all, which is why the
      settings screen reports the grant rather than failing quietly.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
      Per-app color, and the on-device ADB screen's own self-grant. LightOS pins the whole
      phone to monochrome through the accessibility daltonizer; driving that per-app needs this,
      and it is signature|privileged so it never comes from a runtime prompt. Granted once, from
      the app's own ADB screen or a computer:

        adb shell pm grant com.gios.lightcontrol android.permission.WRITE_SECURE_SETTINGS

      Absent, the color feature is inert (every write is swallowed) rather than crashing.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Two jobs: the brightness readout is an overlay window, and on Android 14 this appop
      is also what exempts a sideloaded app from background-activity-start restrictions —
      which is what lets the camera button open the camera from a service.

        adb shell appops set com.gios.lightcontrol SYSTEM_ALERT_WINDOW allow
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The per-app override list needs the names of installed apps. QUERY_ALL_PACKAGES is
      the blunt instrument, but the alternative is a <queries> block that can only ask
      about packages known in advance, and the whole point is a list of everything the
      user has sideloaded.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      The lock face's top bar. A normal permission, granted at install: it answers only
      "is anything connected, and over what", which is what a status bar is for. Signal
      *bars* are deliberately not shown - those need READ_PHONE_STATE, a runtime
      permission LightOS has no screen to grant, and a bar count that silently reads
      empty on a phone with full signal is worse than no bars at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The Wi-Fi login screen's state row: which network is Wi-Fi, and has it validated. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      The hotspot. Everything below is for the presence trigger folded in from BrightHotspot,
      and every one of them is a runtime prompt or a normal permission - the privileged half,
      raising the access point itself, goes over this app's own adb shell instead. See
      hotspot/SoftAp.kt.

      BLUETOOTH_SCAN is what hears the iPad advertising. ACCESS_FINE_LOCATION comes with it on
      this platform whether or not anybody wants a location: a BLE scan is a location signal as
      far as Android is concerned, and neverForLocation is not enough on its own for a scan that
      resolves bonded addresses.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      So the shell comes back by itself after a restart, which is the whole reason this feature
      moved into this app. See hotspot/HotspotBoot.kt.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The ringer, set by which Wi-Fi the phone is on. Two grants, both of which LightOS has no
      screen for:

        adb shell cmd notification allow_dnd com.gios.lightcontrol
        adb shell pm grant com.gios.lightcontrol android.permission.ACCESS_BACKGROUND_LOCATION

      ACCESS_NOTIFICATION_POLICY is what lets an app mute a phone at all - Android counts muting
      as a Do Not Disturb operation, and setRingerMode(SILENT) throws without the policy access
      that `allow_dnd` grants. The background location is what lets the network's *name* be read
      with the screen off: since Android 10 the SSID is redacted from any app that cannot locate
      the phone, and this feature is entirely about a phone in a pocket. ACCESS_FINE_LOCATION is
      already declared above for the BLE scan. Nothing here is stored beyond the network names the
      user has written a rule for, and no location is ever asked for or read.

      Without either grant the feature is inert and the settings screen says which one is missing -
      the alternative is a ringer rule that silently never fires. See audio/WifiRinger.kt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      Signal bars on the lock face, and nothing else. A runtime permission LightOS has
      no screen for, so it is granted once over adb:

        adb shell pm grant com.gios.lightcontrol android.permission.READ_PHONE_STATE

      Without it the cellular bars are drawn as empty outlines rather than as zero -
      "not known" and "no signal" must not look the same. Wi-Fi strength needs nothing.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      The lock face's call card, and only as the fallback underneath the notification's own
      buttons. Answering normally means sending the PendingIntent the dialer already put in the
      shade, which needs nothing granted; this is what answers a call whose buttons could not be
      identified by the words on them, through TelecomManager. A runtime permission with no
      LightOS screen to grant it, so it goes the same way as the rest:

        adb shell pm grant com.gios.lightcontrol android.permission.ANSWER_PHONE_CALLS

      Without it the card still draws and still answers on every dialer that labels its buttons.
    -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      Who is calling, when the dialer never says. LightOS's dialer is a system app that shows its
      own incoming-call activity and posts nothing to the shade, so the notification listener -
      the card's first source for a name - has nothing to read on this phone, and every call drew
      "Incoming call". Telephony will still say, to an app holding these two:

        adb shell pm grant com.gios.lightcontrol android.permission.READ_CALL_LOG
        adb shell pm grant com.gios.lightcontrol android.permission.READ_CONTACTS

      READ_CALL_LOG is what makes the number on the PHONE_STATE broadcast non-empty - Android P
      moved it behind that permission - and READ_CONTACTS turns the number into the name the user
      gave the contact. Nothing is stored: both live in memory for the length of the call. Without
      them the card falls back to the wording it had before. See lock/CallerId.kt.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      The call speaker's level. A normal permission, granted at install. It moves one index on one
      stream, once per call, and only while the route is the phone's own speaker - see
      keys/CallAudio.kt for why that index is the ceiling for any app on this phone.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      The lock background's photo grid. An ordinary runtime prompt, granted from the
      app itself. Needed because the grid walks DCIM and Pictures by path instead of
      asking MediaStore - nothing on LightOS keeps MediaStore current, so the system
      picker does not offer a photo taken minutes ago. A directory listing cannot go
      stale. Same reason BrightChat reads the camera roll this way.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
      Turning the panel on for a banner. A normal permission, granted at install, and the
      reason it is a wake lock at all rather than an activity: `showWhenLocked` occludes the
      keyguard, and an occluded keyguard stops arming this phone's power-button fingerprint
      reader. BrightChat wakes the screen with an activity; this app cannot, and v2.5 and v2.6
      are why. See notify/BannerWake.kt and lock/LockOverlay.kt.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      The USB headphone adapter's own volume - experimental, off by default, and the reason a
      microphone permission is in this manifest.

      Android omits any USB device with an audio-class interface from `UsbManager.getDeviceList()`
      and refuses to open it unless the calling app holds RECORD_AUDIO. That is deliberate on the
      platform's part: a USB audio device is a microphone as often as it is a speaker. Nothing here
      opens an audio input - no AudioRecord, no MediaRecorder anywhere in this app - and the
      permission is only ever *requested* from the DAC screen, once the user has switched the
      feature on. Declining it leaves the feature inert and the screen says which grant is missing.

      An ordinary runtime prompt, so it is deliberately NOT in adb/SelfGrant.kt: a screen whose
      button runs every grant in one go must not be the thing that hands this app a microphone.

      See usb/DacUnlock.kt for what it does with the device once it has one.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Required="false" on purpose. Host mode is what carries the adapter, and a phone without it
      simply never has one attached - which the feature already handles, because "no USB audio
      device attached" is one of the outcomes the DAC screen reports. Marking it required would
      make this app uninstallable on a phone that lacks it, to no gain.
    -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      The two providers the lock face reads: BrightWay's current turn and BrightNotebook's next
      calendar entry. QUERY_ALL_PACKAGES above already grants visibility; the contracts are named
      here anyway, so the dependency is written down where a manifest reader looks for it and the
      face keeps working if that blunt permission is ever narrowed.
    -->
    <queries>
        <package android:name="com.gios.brightway" />
        <package android:name="com.gios.lightnotebook" />
        <provider android:authorities="com.gios.brightway.nav" />
        <provider android:authorities="com.gios.lightnotebook.nextup" />
        <package android:name="com.gios.lightfog" />
        <provider android:authorities="com.gios.lightfog.weather" />
        <package android:name="com.gios.brighthermes" />
        <provider android:authorities="com.gios.brighthermes.deck" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LightControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LightControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              An app in BrightMarket asking for the ADB setup its README describes. Exported on
              purpose, because the sender is another app. Nothing that arrives is executed as
              written: adb/GrantRequest.kt rebuilds every command, pinned to the requesting
              package, and the user approves the result before any of it runs.
            -->
            <intent-filter>
                <action android:name="com.gios.lightcontrol.action.RUN_GRANTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The captive-portal sign-in page. Plain http is allowed app-wide
          (usesCleartextTraffic above) because a portal can only hijack a request it can read:
          the probe URL is http on purpose, and portals themselves are routinely http. Exported
          with the system's CAPTIVE_PORTAL action so "sign in to network" can land here too;
          mostly it is opened by hand from the Wi-Fi login settings screen.
        -->
        <activity
            android:name=".portal.PortalActivity"
            android:exported="true"
            android:label="Wi-Fi login"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LightControl">
            <intent-filter>
                <action android:name="android.net.conn.CAPTIVE_PORTAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The invisible window that carries the USB permission. Experimental; see
          usb/DacAttachActivity.kt for why it has to be an activity and usb/DacUnlock.kt for what
          it triggers.

          android:enabled="false" is load-bearing. With this component live the platform asks the
          user which app should handle every audio adapter they plug in, whether or not the feature
          is switched on - a dialog earned by nothing. DacUnlock.setEnabled flips it with
          setComponentEnabledSetting when the setting changes, so off means no filter, no dialog and
          no window.

          exported="true" because the sender is the system, delivering USB_DEVICE_ATTACHED. Nothing
          that arrives is trusted for anything: the only field read is EXTRA_DEVICE, and a device
          this app has not been granted permission for cannot be opened whatever the intent says.

          noHistory + excludeFromRecents + an empty taskAffinity keep it out of the recents list and
          out of the task the user was already in; the translucent theme and the null window
          animation keep it off the screen. It finishes inside onCreate.
        -->
        <activity
            android:name=".usb.DacAttachActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LightControl.Invisible">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio_devices" />
        </activity>

        <!--
          The lock face is a window, not an activity - added by ControlService at
          TYPE_ACCESSIBILITY_OVERLAY, which is layer 31 and so sits above the keyguard
          at 17. There is deliberately no activity here: `showWhenLocked` marks the
          keyguard *occluded*, and an occluded keyguard stops listening to a
          power-button fingerprint sensor. See lock/LockOverlay.kt.
        -->

        <!--
          Reads the shade so the lock face can list it. Granted once over adb, like
          everything else this app needs:

            adb shell cmd notification allow_listener com.gios.lightcontrol/.lock.LockNotifications

          Nothing is stored and nothing leaves the phone; the list is rebuilt from
          activeNotifications on every change and lives in memory in this process.
        -->
        <service
            android:name=".lock.LockNotifications"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".keys.ControlService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>

        <!--
          Reads the six-digit code off the system pairing dialog so setup needs no computer.
          Scoped to the Settings package in adb_pair_service.xml, and inert unless the user has
          just tapped PAIR AUTOMATICALLY. Separate from ControlService so that service can keep
          its canRetrieveWindowContent="false".
        -->
        <!--
          The presence loop. A foreground service because that is the only way LightOS lets a
          sideloaded app keep a BLE scan alive with the screen off, which is the entire point:
          the hotspot is meant to come up while the phone sits in a pocket.

          Its own service rather than a job on ControlService. The key filter is what this
          phone's buttons depend on, and a scan that misbehaves must not be able to take it
          down - an accessibility service that throws often enough is stood down by the system,
          and standing down the key filter to fix a hotspot would be a poor trade.
        -->
        <!--
          Another app asking for colour, so it does not need WRITE_SECURE_SETTINGS of its own.
          Exported on purpose, because the sender is another app.

          Nothing that arrives here can name anything. The call carries a state - colour, mono, or
          nothing - and a binder whose death drops the request; the calling package comes from
          Binder.getCallingUid, and the request is only ever read for the app that is in front. So
          the worst a caller can do is make its own screen colour. See color/ColorService.kt.

          Its own service rather than a method on the accessibility service above: that one is
          bound by the system and filters every key on this phone, and an interface other apps can
          reach must not be able to take it down.
        -->
        <service
            android:name=".color.ColorService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gios.lightcontrol.action.COLOR" />
            </intent-filter>
        </service>

        <service
            android:name=".hotspot.HotspotService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".hotspot.HotspotBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".adb.AdbPairReader"
            android:exported="true"
            android:label="@string/adb_pair_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/adb_pair_service" />
        </service>

        <!--
          The keyboard-replace prototype. A second window-content reader, scoped to LightOS
          tools in code (prefixes "com.lightos" / "com.thelightphone." — the platform's
          packageNames cannot express a prefix). Separate from ControlService so that service
          can keep its canRetrieveWindowContent="false". Inert unless the user switches
          keyboard replace on.
        -->
        <service
            android:name=".keys.KeyboardService"
            android:exported="true"
            android:label="@string/keyboard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keyboard_service" />
        </service>
    </application>
</manifest>
