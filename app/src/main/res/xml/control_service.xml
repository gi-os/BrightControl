<?xml version="1.0" encoding="utf-8"?>
<!--
  typeWindowStateChanged is the only event type declared, and canRetrieveWindowContent
  stays false: the service needs to know which app came to the front so the mapping can
  differ per app, and an AccessibilityEvent carries its package name without any node
  access. Nothing on screen is ever readable to this service.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:notificationTimeout="0" />
